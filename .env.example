# ---------------------------------------------------------------------------
# Model providers
# Add at least one key (or run Ollama locally, which needs no key).
# You can also paste keys in the app under Settings -> Providers.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# GOOGLE_AI_STUDIO_KEY, GEMINI_API_KEY, and GOOGLE_API_KEY are accepted aliases.
GOOGLE_GENERATIVE_AI_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_AI_STUDIO_KEY=

# Ollama is enabled by default and expects a local server at
# http://127.0.0.1:11434. No key is required.

# ---------------------------------------------------------------------------
# Optional web search providers
# DuckDuckGo is the default and needs no key. If a key is present, it is used
# only when selected under Settings -> General -> Web search.
# ---------------------------------------------------------------------------
BRAVE_API_KEY=
TAVILY_API_KEY=

# ---------------------------------------------------------------------------
# Optional server settings
# ---------------------------------------------------------------------------
# MINIMI_HOST=127.0.0.1
# MINIMI_PORT=8787
# MINIMI_DATA_DIR=/absolute/path/to/minimi-data
# MINIMI_ALLOWED_ORIGINS=http://localhost:1420,http://127.0.0.1:1420
